# Copy to .env and adjust. Every variable is prefixed TECHSO_. Never commit the real .env.

# dev | production. In production the app refuses to start without a real secret key and hides /docs.
TECHSO_ENV=dev

# SQLite for local development. For PostgreSQL use e.g. postgresql+psycopg://techso:PASSWORD@db:5432/techso
TECHSO_DATABASE_URL=sqlite:///./data/techso.db

# REQUIRED in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
TECHSO_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789

# Minutes an access token stays valid (the web app refreshes it while open)
TECHSO_ACCESS_TOKEN_MINUTES=60

# Where evidence photos are stored (outside any web root). Use a mounted volume or S3-compatible gateway in production.
TECHSO_EVIDENCE_DIR=./data/evidence
TECHSO_MAX_UPLOAD_MB=8

# Browser origins allowed to call the API / open the WebSocket (JSON list)
TECHSO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Per-IP request limits (per process; see docs/ARCHITECTURE.md for multi-worker notes)
TECHSO_RATE_LIMIT_PER_MINUTE=600
TECHSO_LOGIN_RATE_PER_MINUTE=20
TECHSO_LOGIN_MAX_FAILURES=5
TECHSO_LOGIN_LOCK_MINUTES=15

# Seconds between escalation / reminder sweeps
TECHSO_ESCALATION_SWEEP_SECONDS=60

# DEMO ONLY: password given to every account created by `python -m app.seed`. The seed refuses to run when TECHSO_ENV=production.
TECHSO_DEMO_PASSWORD=TechSO-demo-1
